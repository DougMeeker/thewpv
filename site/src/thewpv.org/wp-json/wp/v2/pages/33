ignment=&#8221;center&#8221; custom_margin=&#8221;0px||||false|false&#8221; custom_padding=&#8221;0px|0px||0px|false|true&#8221; header_text_shadow_style=&#8221;preset1&#8243; border_width_all=&#8221;6px&#8221; border_color_all=&#8221;#2a98ac&#8221;]<\/p>\n<h1>JOIN WPV<\/h1>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.0.11&#8243; background_color=&#8221;#2a98ac&#8221; height=&#8221;100px&#8221; max_height=&#8221;100px&#8221; custom_margin=&#8221;0px||||false|false&#8221; custom_padding=&#8221;0px|||69px|false|false&#8221;][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.0.11&#8243; background_color=&#8221;#ffffff&#8221; height=&#8221;100px&#8221; max_height=&#8221;100px&#8221; custom_margin=&#8221;0px||||false|false&#8221; custom_padding=&#8221;0px|||69px|false|false&#8221;][et_pb_row _builder_version=&#8221;4.0.11&#8243;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_text _builder_version=&#8221;4.0.11&#8243;]<\/p>\n<h3 style=\"text-align: center;\"><b>There are 3 ways you can get involved with WPV &#8211; as a Client, a Friend (Social Member) or a Volunteer. All 3 are considered Members of the Village, and have access to attend our social and community events.<\/b><\/h3>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.0.11&#8243; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;35px||||false|false&#8221;][et_pb_row column_structure=&#8221;1_3,1_3,1_3&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_column type=&#8221;1_3&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_text_color=&#8221;#293273&#8243; header_6_text_color=&#8221;#293273&#8243; width=&#8221;99.2%&#8221; custom_margin=&#8221;||19px|||&#8221;]<\/p>\n<h1 style=\"text-align: center;\"><strong>Receive Support as a Client (Comprehensive Membership)<\/strong><\/h1>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; custom_padding=&#8221;0px|||||&#8221;]<\/p>\n<p><span style=\"font-weight: 400;\">\u00a0<\/span><span style=\"font-size: large;\">For less than a dollar a day, a comprehensive membership provides you access to community events, social activities, and limited support in the home to help you age-in-place while also staying connected!<\/span><\/p>\n<ul>\n<li><span style=\"font-weight: 400; font-size: large;\">Social Support Calls <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Friendly Visits <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Special Holiday Deliveries <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Social Activities <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Community Events <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Light Chores <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Technology Support <\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Service Referrals<\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Weekly Errand<\/span><\/li>\n<li><span style=\"font-weight: 400; font-size: large;\">Local Community (Senior) Center Membership\u00a0<\/span><\/li>\n<\/ul>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_6_text_color=&#8221;#293273&#8243; custom_margin=&#8221;||19px|||&#8221;]<\/p>\n<p style=\"text-align: center;\"><b>$290.00\/Year<\/b><\/p>\n<p style=\"text-align: center;\"><b style=\"font-size: 22px; text-align: justify;\">OR<\/b><\/p>\n<p style=\"text-align: center;\"><span style=\"font-size: 22px; text-align: left;\">\u00a0<\/span><b style=\"font-size: 22px; text-align: left;\">$29.00\/Month\u00a0<\/b><\/p>\n<p style=\"text-align: center;\">Request more information <a href=\"\/membership-information-request\/\"><strong>here<\/strong>.<\/a><\/p>\n<p>[\/et_pb_text][et_pb_button button_url=&#8221;\/membership-information-request\/&#8221; button_text=&#8221;Become a Client&#8221; button_alignment=&#8221;center&#8221; _builder_version=&#8221;4.0.11&#8243;][\/et_pb_button][\/et_pb_column][et_pb_column type=&#8221;1_3&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_text_color=&#8221;#293273&#8243; header_6_text_color=&#8221;#293273&#8243; custom_margin=&#8221;||||false|false&#8221;]<\/p>\n<h1 style=\"text-align: center;\"><strong>Stay Connected as a Friend (Social Membership)<\/strong><\/h1>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; custom_padding=&#8221;0px|||||&#8221;]<\/p>\n<p><span style=\"font-weight: 400; font-size: large;\">For less than $0.30\/day, our Friends of WPV stay connected with the Village with this tax deductible donation.<\/span><\/p>\n<p><span style=\"font-size: large;\">Friends of WPV get access to a Social Membership, enabling you to attend all WPV social and educational events and participate in our member-led Interest Groups (lunch club, movie outings, Scrabble club, cultural day trips, and more!)<\/span><\/p>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_6_text_color=&#8221;#293273&#8243; custom_margin=&#8221;||19px|||&#8221; custom_padding=&#8221;||0px|||&#8221;]<\/p>\n<p style=\"text-align: center;\">\u00a0<b>$100.00 \/ Year<\/b><b><\/b><\/p>\n<p style=\"text-align: center;\">OR<\/p>\n<p style=\"text-align: center;\"><b style=\"font-size: 22px;\">$9.00 \/ Month Donation\u00a0<\/b><\/p>\n<p style=\"text-align: center;\"><b>\u00a0<\/b><\/p>\n<p>[\/et_pb_text][et_pb_button button_url=&#8221;\/friend-application-form\/&#8221; button_text=&#8221;Become a Friend!&#8221; button_alignment=&#8221;center&#8221; _builder_version=&#8221;4.0.11&#8243;][\/et_pb_button][\/et_pb_column][et_pb_column type=&#8221;1_3&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_text_color=&#8221;#293273&#8243; header_6_text_color=&#8221;#293273&#8243; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;||||false|false&#8221;]<\/p>\n<h1 style=\"text-align: center;\"><strong>Help as a Volunteer (Volunteer Membership)<\/strong><\/h1>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; custom_padding=&#8221;0px|||||&#8221;]<\/p>\n<p style=\"text-align: left;\"><span style=\"font-weight: 400; font-size: large;\">Volunteer to strengthen the social and intergenerational ties in the community and support your older neighbors.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400; font-size: large;\">As a consistent volunteer, we invite you to attend various community events and social activities in the Village.<\/span><\/p>\n<p><span style=\"font-weight: 400; font-size: large;\">Your contribution of service gives you membership, but we recommend the following donations to cover costs of screening for safety in the community.<\/span><br \/>\n[\/et_pb_text][et_pb_text _builder_version=&#8221;4.0.11&#8243; text_text_color=&#8221;#293273&#8243; text_font_size=&#8221;22px&#8221; text_line_height=&#8221;1.2em&#8221; link_text_color=&#8221;#fdd237&#8243; header_6_text_color=&#8221;#293273&#8243; custom_margin=&#8221;||19px|||&#8221;]<\/p>\n<p style=\"text-align: center;\"><b>$30.00 \/ One-time Background Screening Donation\u00a0<\/b><b>+\u00a0<\/b><\/p>\n<p style=\"text-align: center;\"><b>$10.00\/ Annual Verification Update Donation<br \/>\n<\/b><\/p>\n<p style=\"text-align: center;\">To become a volunteer member click<a href=\"\/volunteer\"> <strong>here.<\/strong><\/a><\/p>\n<p>[\/et_pb_text][et_pb_button button_url=&#8221;https:\/\/thewpv.org\/volunteer\/&#8221; button_text=&#8221;Become a Volunteer&#8221; button_alignment=&#8221;center&#8221; _builder_version=&#8221;4.0.11&#8243;][\/et_pb_button][\/et_pb_column][\/et_pb_row][et_pb_row _builder_version=&#8221;4.0.11&#8243; custom_margin=&#8221;|368px||auto||&#8221; custom_padding=&#8221;|||325px|false|false&#8221; locked=&#8221;off&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_text _builder_version=&#8221;4.0.11&#8243; hover_enabled=&#8221;0&#8243;]<\/p>\n<h3 style=\"text-align: center;\"><strong>Download our brochure for more information here: <\/strong><\/h3>\n<h3 style=\"text-align: center;\"><strong><a href=\"https:\/\/thewpv.org\/wp-content\/uploads\/2025\/05\/24-0821-WPV-Trifold-2-pages.pdf\"><span style=\"text-decoration: underline;\">WPV Brochure<\/span><\/a><\/strong><\/h3>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.0.11&#8243; background_color=&#8221;#2a98ac&#8221; height=&#8221;112px&#8221; custom_padding=&#8221;||0px|||&#8221; global_module=&#8221;2125&#8243; collapsed=&#8221;off&#8221;][et_pb_row column_structure=&#8221;1_3,1_3,1_3&#8243; use_custom_gutter=&#8221;on&#8221; gutter_width=&#8221;2&#8243; _builder_version=&#8221;4.0.11&#8243; width=&#8221;100%&#8221;][et_pb_column type=&#8221;1_3&#8243; _builder_version=&#8221;4.0.11&#8243;][et_pb_code _builder_version=&#8221;4.0.11&#8243; background_c